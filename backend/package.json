{
  "name": "backend",
  "version": "1.0.12",
  "description": "SignPakCommons API: Express, Node.js and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/security/**/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:security": "node --test --test-concurrency=1 \"tests/security/**/*.test.js\"",
    "test:coverage": "c8 --config .c8rc.json npm test && node scripts/check-coverage.js",
    "e2e:server": "node scripts/e2e-server.js"
  },
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.13",
    "multer": "^2.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9"
  }
}

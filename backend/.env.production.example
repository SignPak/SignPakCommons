# Production template for the API server (api.commons.signpak.tech, behind Nginx + PM2).
#
#   cp .env.production.example .env && chmod 600 .env
#
# Then fill in every empty value. Never commit .env.
# Step-by-step server setup: deploy/README.md. Every variable: docs/setup.md.
# For local development use .env.example instead; these values will not run on localhost.

NODE_ENV=production
PORT=5000
# Listen on loopback only: Nginx on this machine is the only client. Anyone who could reach
# Node directly could forge X-Forwarded-For (trusted below) and dodge IP restrictions and rate
# limits. 127.0.0.1 is also the production default when HOST is unset.
HOST=127.0.0.1
LOG_LEVEL=info
# Nginx is the only client Node sees; trust its X-Forwarded-For so rate limits and IP
# restrictions see real visitors. The server logs a warning at startup if this is off.
TRUST_PROXY=true

# MongoDB Atlas. Allow the server's IP in Atlas > Network Access.
MONGODB_URI=

# The site on Vercel. Same site as the API, so the login cookie works with SameSite=Lax (D2).
CLIENT_ORIGIN=https://commons.signpak.tech

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# Real email. EMAIL_DRIVER=capture and E2E_TEST_HOOKS are refused in production.
EMAIL_DRIVER=brevo
BREVO_API_KEY=
# signpak.tech must be authenticated in Brevo first (Senders, Domains & Dedicated IPs ->
# Domains -> add the DNS records Brevo shows; deploy/README.md section 1). Until then Brevo
# rejects this sender or the codes land in spam.
BREVO_SENDER_EMAIL=no-reply@signpak.tech
BREVO_SENDER_NAME=SignPak Commons
# The SRS decision is 10 minutes (FIX-PLAN section 0).
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

WEB3FORMS_ACCESS_KEY=
CONTACT_DAILY_LIMIT=25
CONTACT_USER_DAILY_LIMIT=1
# Signed-out deletion requests per IP and per device each UTC day (S4).
CONTACT_SENDER_DAILY_LIMIT=2

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_SURNAME=Signpak

# Reference videos and contributor recordings both go to Google Drive through the OAuth
# refresh token (D3). The OAuth consent screen must be "In production": "Testing" tokens
# expire after 7 days and uploads stop working.
STORAGE_DRIVER=gdrive
ARCHIVE_STORAGE_DRIVER=gdrive
# Temporary uploads land here before they are sent to Drive.
UPLOAD_DIR=uploads
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Optional: a separate account/folder for recordings. Leave unset to share the values above.
# GOOGLE_ARCHIVE_OAUTH_CLIENT_ID=
# GOOGLE_ARCHIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_ARCHIVE_OAUTH_REFRESH_TOKEN=
# GOOGLE_ARCHIVE_DRIVE_FOLDER_ID=

MAX_VIDEO_UPLOAD_MB=90
# Nginx allows 110m (deploy/nginx/api.conf). Behind Cloudflare (free plan caps bodies at
# 100 MB), use 95.
MAX_RECORDING_UPLOAD_MB=100

RATE_LIMIT_ENABLED=true
SUBMISSION_COOLDOWN_MS=30000

# Optional Upstash Redis cache for the public landing-page counts.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

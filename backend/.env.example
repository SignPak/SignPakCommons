# Copy this file to .env and fill it in. Never commit .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Set to true when the API runs behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/signpakcommons

# Browser origin(s) allowed to call the API with cookies. Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# Defaults to true in production, false otherwise. Must be true when COOKIE_SAMESITE=none.
# COOKIE_SECURE=false
# lax works when the app and API share a site (localhost, or a Vite proxy in dev).
# Use none (with COOKIE_SECURE=true) only if they live on different sites.
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# The admin account is created (or promoted) from these on every start.
ADMIN_EMAIL=admin@signpak.dev
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_SURNAME=Signpak

# Where uploaded files go. For Google Drive, share the target folder with the service account email.
STORAGE_DRIVER=local
# Submission recordings are append-only archives. Set this to gdrive for Drive storage.
ARCHIVE_STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Required when STORAGE_DRIVER=gdrive. Store the whole service-account JSON as one environment value.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id
MAX_VIDEO_UPLOAD_MB=300
MAX_RECORDING_UPLOAD_MB=100
SUBMISSION_COOLDOWN_MS=30000

RATE_LIMIT_ENABLED=true

# Minimum gap, in milliseconds, between two submissions for the same (user, video).
SUBMISSION_COOLDOWN_MS=30000

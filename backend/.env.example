# Local development template: copy to .env and fill it in. Never commit .env.
# Production server: start from .env.production.example instead (see deploy/README.md).

NODE_ENV=development
PORT=5000
# Listen address. Unset: 0.0.0.0 here (reachable from your LAN), 127.0.0.1 in production.
# HOST=0.0.0.0
LOG_LEVEL=info
# Set to true when the API runs behind a reverse proxy (Nginx in production), so rate limits
# and IP restrictions see the visitor's address from X-Forwarded-For.
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/signpakcommons

# Browser origin(s) allowed to call the API with cookies. Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Key for the email hashes in deletion records (C3). Generate once with
# `openssl rand -hex 32`, back it up with the other secrets, and never change it.
EMAIL_HASH_SECRET=
JWT_EXPIRES_DAYS=7
# Defaults to true in production, false otherwise. Must be true when COOKIE_SAMESITE=none.
# COOKIE_SECURE=false
# lax works when the site and the API share a site: localhost (or the Vite proxy) in dev,
# commons.signpak.tech and api.commons.signpak.tech in production. Use none (with COOKIE_SECURE=true) only if
# they ever live on different sites, which browsers that block third-party cookies break.
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# How authentication codes are delivered: brevo sends real email, capture keeps them in
# memory for the automated tests. The server refuses to start with capture in production.
EMAIL_DRIVER=brevo

# Brevo transactional email. Verify this sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=auth@signpakcommons.org
BREVO_SENDER_NAME=SignPak Commons
# One-time verification/reset codes expire after this many minutes.
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
# Wrong passwords before an account is locked, and for how long (S2).
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Web3Forms contact form delivery; get the access key from web3forms.com.
WEB3FORMS_ACCESS_KEY=
CONTACT_DAILY_LIMIT=25
CONTACT_USER_DAILY_LIMIT=1
# Signed-out deletion requests per IP and per device each UTC day (S4).
CONTACT_SENDER_DAILY_LIMIT=2
# Deletion-request code emails to one address per UTC day, across all requests (S4).
CONTACT_CODE_EMAILS_PER_DAY=5

# The admin account is created (or promoted) from these on every start.
ADMIN_EMAIL=admin@signpak.dev
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_SURNAME=Signpak
# S7: more admins, comma-separated (optional). Each person first signs up on the site as
# usual; on the next restart their account becomes an admin. An admin who is not on
# ADMIN_EMAIL or this list goes back to a normal account at startup (never the last active
# admin). Restart the server after editing it.
ADMIN_EMAILS=

# Where uploaded files go. For Google Drive, share the target folder with the service account email.
STORAGE_DRIVER=local
# Submission recordings are append-only archives. Set this to gdrive for Drive storage.
ARCHIVE_STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Required when STORAGE_DRIVER=gdrive. Store the whole service-account JSON as one environment value.
# GOOGLE_OAUTH_CLIENT_ID=<your client id>
# GOOGLE_OAUTH_CLIENT_SECRET=<your client secret>
# GOOGLE_OAUTH_REFRESH_TOKEN=<the refresh token>
# GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id

# Optional: use a SECOND Google account/folder for archived recordings, kept separate from
# the base-video account above (different service account and/or different Drive account).
# When unset, ARCHIVE_STORAGE_DRIVER=gdrive falls back to the shared credentials above.
# GOOGLE_ARCHIVE_OAUTH_CLIENT_ID=<your client id>
# GOOGLE_ARCHIVE_OAUTH_CLIENT_SECRET=<your client secret>
# GOOGLE_ARCHIVE_OAUTH_REFRESH_TOKEN=
# GOOGLE_ARCHIVE_DRIVE_FOLDER_ID=the-second-account-folder-id

MAX_VIDEO_UPLOAD_MB=90
MAX_RECORDING_UPLOAD_MB=100

RATE_LIMIT_ENABLED=true

# Test hooks only. With NODE_ENV=test this mounts GET /__test/emails so the Playwright suite
# can read the codes the capture driver recorded. The server refuses to start if this is set
# with NODE_ENV=production. Leave it unset everywhere else.
# E2E_TEST_HOOKS=false

# Optional Upstash Redis REST credentials for caching public landing-page counts
# for 12 hours. Set both values to enable the cache.
# UPSTASH_REDIS_REST_URL=https://<database-id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Minimum gap, in milliseconds, between two submissions for the same (user, video).
SUBMISSION_COOLDOWN_MS=30000
